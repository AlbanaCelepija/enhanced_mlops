###  https://purl.org/fairops/indiv#FalseDiscoveryParity
indiv:FalseDiscoveryParity rdf:type owl:NamedIndividual ,
                                    core:ObservationalFairnessNotion ,
                                    core:SufficiencyFairnessNotion ;
                           core:isMeasuredBy indiv:FalseDiscoveryRate ;
                           core:isProposedBy <https://purl.org/fairops/papers#2019_CELIS> ;
                           core:isSuitableFor core:Conversation ,
                                              core:Prediction ;
                           core:isUsedBy <https://purl.org/fairops/papers#2019_CELISa> ;
                           core:refersTo core:Classification ;
                           core:scientificArtifactDescription """it focuses on equality of False Positive Rates (FPR) across privileged and unprivileged groups. I.e., for each group you compute of all the predicted positive, how many were actually negative (predicted bad). The rates should be equal across different groups. Such notion is useful in cases when false prediction results in additional costs, for example, when classifying whether a person has a medical condition or not. It is mathematically defined as: $P(Y = 0, \\hat{Y} = 1, A = a) = P(Y = 0, \\hat{Y} = 1, A = b),
\\quad \\text{i.e.,} \\quad \\mathrm{FDR}(a) = \\mathrm{FDR}(b).$""" .


