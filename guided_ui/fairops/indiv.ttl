###  https://purl.org/fairops/indiv#GroupUnfairness
indiv:GroupUnfairness rdf:type owl:NamedIndividual ,
                               core:AmortizedGranularityMetric ,
                               core:ImpactFocusedMetric ,
                               core:ItemFocusedMetric ,
                               core:SingleGranularityMetric ,
                               core:TreatmentFocusedMetric ,
                               core:UserFocusedMetric ;
                      core:extends indiv:Variance ;
                      core:isProposedBy <https://purl.org/fairops/papers#2019_RASTEGARPANAH> ;
                      core:isSuitableFor core:Recommendation ;
                      core:measures indiv:FairRecommendationForCustomer ,
                                    indiv:QualityWeightedFairness ,
                                    indiv:UniformFairness ;
                      core:refersTo core:ScoringRegression ;
                      core:scientificArtifactDescription """Let $I$ be the set of all users/items and $G = \\{G_1, \\dots, G_d\\}$ be a partition of users/items into $d$ groups, i.e., $I = \\bigcup_{i \\in \\{1, \\dots, d\\}} G_i$. We define the loss of group $i$ as the mean squared estimation error over all known ratings in group $i$:
\\begin{equation}
L_i = \\frac{\\left\\| P_{\\Omega_{G_i}} \\left( \\hat{X} - X \\right) \\right\\|_2^2}{|\\Omega_{G_i}|}
\\end{equation}

For a given partition $G$, we define the group unfairness as the variance of all group losses:
\\begin{equation}
R_{\\text{grp}}(X, \\hat{X}, G) = \\frac{1}{d^2} \\sum_{k=1}^{d} \\sum_{l>k} (L_k - L_l)^2
\\end{equation}

Again, to improve group fairness, we seek to minimize $R_{\\text{grp}}$.""" .


###  https://purl.org/fairops/indiv#HONEST
indiv:HONEST rdf:type owl:NamedIndividual ,
                      core:LexiconFairnessMetric ;
             core:isProposedBy <https://purl.org/fairops/papers#2021_NOZZA> ;
             core:isSuitableFor core:Conversation ;
             core:refersTo core:TextGeneration .


###  https://purl.org/fairops/indiv#IndividualConsistencyScore
indiv:IndividualConsistencyScore rdf:type owl:NamedIndividual ,
                                          core:DistanceBasedFairnessMetric ;
                                 core:extends indiv:ConsistencyScore ;
                                 core:isProposedBy <https://purl.org/fairops/papers#2025_WALLER> ;
                                 core:isSuitableFor core:Prediction ,
                                                    core:Recommendation ;
                                 core:measures indiv:FairnessThroughAwareness ;
                                 core:refersTo core:Classification ;
                                 core:scientificArtifactDescription """It is an extension of the consistency score, which does not provide an overall (average) evaluation of the individual fairness performance of the predictor, but is able to asses how fair the model is for any individual in the dataset. Given a binary classifier $f$ for a dataset $E$ and an individual $x \\in E$, 
the individual consistency score $c_{\\sigma,k}(x)$ computes the proportion of 
$x$'s $k$ most similar individuals (according to $\\sigma$) that receive the same 
classification as $x$:
\\[
c_{\\sigma,k}(x)
= 1 - \\left| f(x) - \\frac{1}{k} 
\\sum_{y \\in {nbr}_{\\sigma}(x,k)} f(y) \\right| .
\\]""" .


###  https://purl.org/fairops/indiv#IndividualFairness
indiv:IndividualFairness rdf:type owl:NamedIndividual .


###  https://purl.org/fairops/indiv#IndividualUnfairness
indiv:IndividualUnfairness rdf:type owl:NamedIndividual ,
                                    core:AmortizedGranularityMetric ,
                                    core:ImpactFocusedMetric ,
                                    core:ItemFocusedMetric ,
                                    core:SingleGranularityMetric ,
                                    core:TreatmentFocusedMetric ,
                                    core:UserFocusedMetric ;
                           core:extends indiv:Variance ;
                           core:isProposedBy <https://purl.org/fairops/papers#2019_RASTEGARPANAH> ;
                           core:isSuitableFor core:Recommendation ;
                           core:measures indiv:FairRecommendationForCustomer ,
                                         indiv:QualityWeightedFairness ,
                                         indiv:UniformFairness ;
                           core:refersTo core:ScoringRegression ;
                           core:scientificArtifactDescription """For each user $i$, we define $l_i$, the loss of user $i$, as the mean squared error over known ratings of user $i$:
\\begin{equation}
l_i = \\frac{\\left\\| P_{\\Omega^i} \\left( \\hat{x}_i - x_i \\right) \\right\\|_2^2}{|\\Omega_i|}
\\end{equation}

Then we define the individual unfairness as the variance of the user losses:
\\begin{equation}
R_{\\text{indv}}(X, \\hat{X}) = \\frac{1}{n^2} \\sum_{k=1}^{n} \\sum_{l>k} (l_k - l_l)^2
\\end{equation}

To improve individual fairness, we seek to minimize $R_{\\text{indv}}$.""" .


