###  https://purl.org/fairops/indiv#ChangeAttentionScores
indiv:ChangeAttentionScores rdf:type owl:NamedIndividual ,
                                     core:HeadOnly ;
                            core:scientificArtifactDescription "Address stereotypes learned in the attention layer of sentence-level encoders by redistributing attention scores, fine-tuning the encoder with an equalization loss that encourages equal attention scores (e.g., to attend to “doctor”) with respect to each social group (e.g., “he” and “she”), while minimizing changes to the attention of other words in the sentence. The equalization loss is added as a regularization term to a semantic information preservation term that computes the distance between the original and fine-tuned models’ attention scores." .


###  https://purl.org/fairops/indiv#ChangeAttentionWeights
indiv:ChangeAttentionWeights rdf:type owl:NamedIndividual ,
                                      core:SelectiveParameterUpdating ;
                             core:scientificArtifactDescription "modify the attention weights after training, applying temperature scaling controlled by a hyperparameter that can be tuned to maximize some fairness metric. The hyperparameter can either increase entropy to focus on a broader set of potentially less stereotypical tokens, or can decrease entropy to attend to a narrower context, which may reduce exposure to stereotypical tokens." .


###  https://purl.org/fairops/indiv#CoOccurrenceBiasScore
indiv:CoOccurrenceBiasScore rdf:type owl:NamedIndividual ,
                                     core:DistributionFairnessMetric ;
                            core:isProposedBy <https://purl.org/fairops/papers#2019_BORDIA> ;
                            core:isSuitableFor core:Conversation ;
                            core:refersTo core:TextGeneration .


###  https://purl.org/fairops/indiv#ConditionalEqualOpportunity
indiv:ConditionalEqualOpportunity rdf:type owl:NamedIndividual ,
                                           core:ObservationalFairnessNotion ,
                                           core:SeparationFairnessNotion ;
                                  core:extends indiv:EqualOpportunity ,
                                               indiv:StatisticalParity ;
                                  core:isProposedBy <https://purl.org/fairops/papers#2019_BEUTEL> ;
                                  core:isSuitableFor core:Conversation ,
                                                     core:Prediction ;
                                  core:refersTo core:Classification ,
                                                core:TextGeneration ;
                                  rdfs:comment "Extends both Statistical parity and Equal opportunity (although considers FPRs instead of TPRs)" .


###  https://purl.org/fairops/indiv#ConditionalProcedureAccuracyEquality
indiv:ConditionalProcedureAccuracyEquality rdf:type owl:NamedIndividual ,
                                                    core:ObservationalFairnessNotion ,
                                                    core:SeparationFairnessNotion ;
                                           core:extends indiv:EqualOpportunity ,
                                                        indiv:PredictiveEquality ;
                                           core:isEquivalentTo indiv:EqualizedOdds ;
                                           core:isMeasuredBy indiv:OutcomeUnfairness ;
                                           core:isProposedBy <https://purl.org/fairops/papers#2021_BERK> ;
                                           core:isSuitableFor core:Conversation ,
                                                              core:Prediction ;
                                           core:refersTo core:Classification ,
                                                         core:TextGeneration ;
                                           rdfs:comment "Equal opportunity  and Predictive equality  i.e., if you satisfy Equalized odds, than you also satisfy Equal opportunity" .


###  https://purl.org/fairops/indiv#ConditionalStatisticalParity
indiv:ConditionalStatisticalParity rdf:type owl:NamedIndividual ,
                                            core:IndependenceFairnessNotion ,
                                            core:ObservationalFairnessNotion ;
                                   core:extends indiv:FairnessThroughUnawareness ,
                                                indiv:StatisticalParity ;
                                   core:isProposedBy <https://purl.org/fairops/papers#2017_CORBETT_DAVIES> ;
                                   core:isSuitableFor core:Conversation ,
                                                      core:Prediction ,
                                                      core:Recommendation ;
                                   core:refersTo core:Classification ,
                                                 core:TextGeneration ;
                                   rdfs:comment "Conditional statistical parity is closely related to the idea of fairness through blindness (i.e., unawareness[Ndr]), in which one attempts to create fair algorithms by prohibiting use of protected attributes, such as race. However, as frequently noted, it is difficult to restrict to “legitimate” features that do not at least partially correlate with race and other protected attributes, and so one cannot be completely “blind” to the sensitive information. Moreover, unlike the other definitions of fairness, this one does not necessarily re- duce racial disparities. Conditional statistical parity mitigates these limitations of the blindness approach while preserving its intuitive appeal. [2017_CORBETT_DAVIES]" .


###  https://purl.org/fairops/indiv#ConditionalUseAccuracyEquality
indiv:ConditionalUseAccuracyEquality rdf:type owl:NamedIndividual ,
                                              core:ObservationalFairnessNotion ,
                                              core:SufficiencyFairnessNotion ;
                                     core:extends indiv:PredictiveParity ,
                                                  indiv:TestFairness ;
                                     core:isProposedBy <https://purl.org/fairops/papers#2021_BERK> ;
                                     core:isSuitableFor core:Conversation ,
                                                        core:Prediction ;
                                     core:refersTo core:Classification ,
                                                   core:TextGeneration ;
                                     rdfs:comment "similar to Conditional procedure accuracy equality (=Equalized odds) but conditioning on predicted values (i.e, P' and N') instead of the actual ones (P and N)  Also extends Test fairness/Predictive parity that just looks to the TP" .


###  https://purl.org/fairops/indiv#ConsistencyScore
indiv:ConsistencyScore rdf:type owl:NamedIndividual ,
                                core:DistanceBasedFairnessMetric ;
                       core:isEquivalentTo indiv:FairnessThroughAwareness ;
                       core:isProposedBy <https://purl.org/fairops/papers#2013_ZEMEL> ;
                       core:isSuitableFor core:Prediction ,
                                          core:Recommendation ;
                       core:isUsedBy <https://purl.org/fairops/papers#2025_WALLER> ;
                       core:measures indiv:FairnessThroughAwareness ;
                       core:refersTo core:Classification ;
                       core:scientificArtifactDescription """It measures the overall level of disparity in the classification of individuals with respect to similar individuals, using the k nearest neighbours.  To do so, $yNN$ gives a value in the interval [0, 1], and the higher the value, the lower the level of disparity overall: $y_{\\mathrm{NN}} 
= 1 - \\frac{1}{N_k} \\sum_{n}
\\left| \\hat{y}_n - \\sum_{j \\in k\\text{-NN}(x_n)} \\hat{y}_j \\right| $, where $x_n$ is one of the $N$ examples in the training set.""" ;
                       rdfs:comment "The aggregation potentially masks high levels of disparity for particular individuals. Very similar to Fairness through awareness, but does not require domain knowledge to define 𝑑." .


