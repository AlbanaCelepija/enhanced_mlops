###  https://purl.org/fairops/indiv#EqualizedOdds
indiv:EqualizedOdds rdf:type owl:NamedIndividual ,
                             core:ObservationalFairnessNotion ,
                             core:SeparationFairnessNotion ;
                    core:extends indiv:EqualOpportunity ,
                                 indiv:OverallAccuracyEquality ,
