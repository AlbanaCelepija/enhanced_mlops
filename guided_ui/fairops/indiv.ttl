<https://purl.org/fairops/indiv> rdf:type owl:Ontology ;
                                  owl:imports <https://purl.org/fairops/core> ,
                                              <https://purl.org/fairops/papers> .

#################################################################
#    Individuals
#################################################################

###  https://purl.org/fairops/core#BiasPerpetuation
core:BiasPerpetuation core:isAddressedWith indiv:EqualOpportunity ,
                                           indiv:StatisticalParity ;
                      core:requires core:DatasetRepresentativenessReport ,
                                    core:ParityErrorGapDashboard ,
                                    core:PrePostMitigationComparisonReport .


###  https://purl.org/fairops/core#DerogatoryLanguage
core:DerogatoryLanguage core:isAddressedWith indiv:EqualOpportunity ,
                                             indiv:StatisticalParity ;
                        core:requires core:DocumentationOfSafeguardsAndEffectiveness ,
                                      core:LogsOfInterventions ,
                                      core:LongitudinalKPIsTrendsOverTime ,
                                      core:SafetyFairnessEvaluationSuite .


###  https://purl.org/fairops/core#DisparateSystemPerformance
core:DisparateSystemPerformance core:isAddressedWith indiv:OverallAccuracyEquality ;
                                core:requires core:DatasetRepresentativenessReport ,
                                              core:GroupWisePerformanceAndCalibrationDashboards ,
                                              core:RemediationRecordsAndPostFixVerification .


###  https://purl.org/fairops/core#Erasure
core:Erasure core:isAddressedWith indiv:EqualOpportunity ,
                                  indiv:EqualizedOdds ;
             core:requires core:DatasetRepresentativenessReport ,
                           core:EvaluationReportsOnOmissionCoverageGaps ,
                           core:GovernanceRecordsForDatasetUpdates .


###  https://purl.org/fairops/core#ExclusionaryNorms
core:ExclusionaryNorms core:isAddressedWith indiv:StatisticalParity ;
                       core:requires core:LogsOfInterventions ,
                                     core:LongitudinalKPIsTrendsOverTime ,
                                     core:PatternBasedEvaluationResults ,
                                     core:RecordOfPolicyChanges ,
                                     core:SafetyFairnessEvaluationSuite .


###  https://purl.org/fairops/core#FeedbackLoopOverfitting
core:FeedbackLoopOverfitting core:isAddressedWith indiv:Calibration ,
                                                  indiv:StatisticalParity ;
                             core:requires core:DriftContextShiftLogs ,
                                           core:LongitudinalParityErrorDivergenceTrendsReport ,
                                           core:RetrainingDecisionRecordsAndEffectivenessEvidence .


