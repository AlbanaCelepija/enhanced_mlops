###  https://purl.org/fairops/core#IncompleteHistoricalExamples
core:IncompleteHistoricalExamples core:isAddressedWith indiv:EqualOpportunity ,
                                                       indiv:OverallAccuracyEquality ,
                                                       indiv:StatisticalParity ;
                                  core:requires core:DocumentationOnJustificationOfEnrichmentStrategiesAndResidualRisk .


###  https://purl.org/fairops/core#Misrepresentation
core:Misrepresentation core:isAddressedWith indiv:Calibration ,
                                            indiv:EqualOpportunity ,
                                            indiv:EqualizedOdds ,
                                            indiv:StatisticalParity ;
                       core:requires core:LogsOfInterventions ,
                                     core:RemediationRecordsAndPostFixVerification ,
                                     core:SegmentLevelCalibrationPerformanceEvidence ,
                                     core:StructuredEvaluationOnGroupConditionedFactualityConsistency ,
                                     core:UserFacingInstructions .


###  https://purl.org/fairops/core#MisrepresentationsInProductMarketing
core:MisrepresentationsInProductMarketing core:isAddressedWith indiv:Calibration ;
                                          core:requires core:LogsOfInterventions ,
                                                        core:ParityErrorGapDashboard ,
                                                        core:SegmentLevelCalibrationPerformanceEvidence .


###  https://purl.org/fairops/core#PopularItemsOverrecommended
core:PopularItemsOverrecommended core:isAddressedWith indiv:EqualityOfAttention ,
                                                      indiv:EquityOfAmortizedAttention ,
                                                      indiv:EquityOfAttention ,
                                                      indiv:OverallAccuracyEquality ,
                                                      indiv:StatisticalParity ;
                                 core:requires core:ExposureDistributionReports ,
                                               core:HumanOversightRulesThresholdsForIntervention ,
                                               core:ParityErrorGapDashboard .


###  https://purl.org/fairops/core#Stereotyping
core:Stereotyping core:isAddressedWith indiv:EqualOpportunity ,
                                       indiv:StatisticalParity ;
                  core:requires core:BenchmarkAndCounterfactualEvaluationReports ,
                                core:GovernanceRecordsForDatasetUpdates ,
                                core:LongitudinalKPIsTrendsOverTime ,
                                core:PrePostMitigationComparisonReport .


###  https://purl.org/fairops/core#Toxicity
core:Toxicity core:isAddressedWith indiv:StatisticalParity ;
              core:requires core:DocumentationOfSafeguardsAndEffectiveness ,
                            core:GlobalKPIEvaluationReport ,
                            core:GroupWisePerformanceAndCalibrationDashboards ,
                            core:LongitudinalKPIsTrendsOverTime ,
                            core:RemediationRecordsAndPostFixVerification .


###  https://purl.org/fairops/indiv#ADELE
indiv:ADELE rdf:type owl:NamedIndividual ,
                     core:Adapters ;
            core:scientificArtifactDescription "Introduce debiasing adapter modules, called ADELE, to mitigate gender bias. The technique is based on modular adapter frameworks (2019_HOULSBY) that add new, randomly initialized layers between the original layers for parameter-efficient fine-tuning; only the injected layers are updated during fine-tuning, while the pre-trained ones remain frozen." .


###  https://purl.org/fairops/indiv#AbsoluteDifference
indiv:AbsoluteDifference rdf:type owl:NamedIndividual ,
                                  core:AmortizedGranularityMetric ,
                                  core:ImpactFocusedMetric ,
                                  core:ItemFocusedMetric ,
                                  core:SingleGranularityMetric ,
                                  core:TreatmentFocusedMetric ,
                                  core:UserFocusedMetric ;
                         core:extends indiv:NonParityUnfairness ;
                         core:isProposedBy <https://purl.org/fairops/papers#2018_ZHU> ,
                                           <https://purl.org/fairops/papers#2020_FU> ,
                                           <https://purl.org/fairops/papers#2021_LI> ,
                                           <https://purl.org/fairops/papers#2021_WANG> ,
                                           <https://purl.org/fairops/papers#2023_WANG> ;
                         core:isSuitableFor core:Recommendation ;
                         core:isUsedBy <https://purl.org/fairops/papers#2018_ZHU> ,
                                       <https://purl.org/fairops/papers#2020_FU> ,
                                       <https://purl.org/fairops/papers#2021_LI> ,
                                       <https://purl.org/fairops/papers#2021_WANG> ;
                         core:measures indiv:StatisticalParity ;
                         core:refersTo core:ScoringRegression .


###  https://purl.org/fairops/indiv#AbsoluteUnfairness
indiv:AbsoluteUnfairness rdf:type owl:NamedIndividual ,
                                  core:AmortizedGranularityMetric ,
                                  core:UserFocusedMetric ;
                         core:isProposedBy <https://purl.org/fairops/papers#2017_YAO> ;
                         core:isSuitableFor core:Recommendation ;
                         core:isUsedBy <https://purl.org/fairops/papers#2018_FARNADI> ,
                                       <https://purl.org/fairops/papers#2021_ISLAM> ;
                         core:measures indiv:EqualOpportunity ;
                         core:refersTo core:ScoringRegression .


###  https://purl.org/fairops/indiv#AddNonToxicExamples
indiv:AddNonToxicExamples rdf:type owl:NamedIndividual ,
                                   core:SyntheticData ;
                          core:scientificArtifactDescription "Add non-toxic examples for groups disproportionately represented with toxicity, until the distribution between toxic and non-toxic examples is balanced across groups." .


###  https://purl.org/fairops/indiv#AdvBERT
indiv:AdvBERT rdf:type owl:NamedIndividual ,
                       core:AdversarialLearning ;
              core:scientificArtifactDescription "Adversarial learning with a ranking of information retrieval results to reduce bias while maintaining relevance, proposing a gender-invariant ranking model. Contrastive pairs consist of a relevant and non-relevant document to a query, with a corresponding social group label denoting if the query or document contains the protected attribute. The adversarial discriminator predicts the social group label from an encoder, while the encoder simultaneously tries to trick the discriminator while also maximizing relevance scores." .


###  https://purl.org/fairops/indiv#AdvPredictedScore
indiv:AdvPredictedScore rdf:type owl:NamedIndividual ,
                                 core:AdversarialLearning ;
                        core:scientificArtifactDescription "Learn fair predicted scores by enhancing score distribution similarity" .


###  https://purl.org/fairops/indiv#AdversarialFDP
indiv:AdversarialFDP rdf:type owl:NamedIndividual ,
                              core:AdversarialLearning ;
                     core:scientificArtifactDescription "The adversary seeks to determine whether the training process is fair, and when not, feedback from the adversary is used to improve the model. Uses FDR as a fariness metric within the adversary to apply feedback for model tuning as a form of in-processing: the adversary penalizes the model if a sensitive variable is predictable from the dependent variable." .


###  https://purl.org/fairops/indiv#AllUnmaskedLikelihood
indiv:AllUnmaskedLikelihood rdf:type owl:NamedIndividual ,
                                     core:PseudoLogLikelihoodFairnessMetric ;
                            core:extends indiv:ContextAssociationTest ,
                                         indiv:CrowSPairsScore ;
                            core:isProposedBy <https://purl.org/fairops/papers#2022_KANEKO> ;
                            core:isSuitableFor core:Conversation ;
                            core:refersTo core:TextGeneration ;
                            core:scientificArtifactDescription "Extends the CrowS-Pair Score and CAT to consider multiple correct candidate predictions. While pseudo-loglikelihood and CAT consider a single correct answer for a masked test example, AUL provides an unmasked sentence to the model and predicts all tokens in the sentence. The unmasked input provides the model with all information to predict a token, which can improve the prediction accuracy of the model, and avoids selection bias in the choice of which words to mask." .


###  https://purl.org/fairops/indiv#Art.10
indiv:Art.10 rdf:type owl:NamedIndividual ,
                      core:TechnicalLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:ConditionalStatisticalParity ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:FairnessThroughAwareness ,
                                      indiv:IndividualFairness ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:BlocklistDocumentRemoval ,
                                               indiv:CDA ,
                                               indiv:ControlOffensiveTokens ,
                                               indiv:GenderneutralAlternatives ,
                                               indiv:LogLikeDocumentRemoval ,
                                               indiv:PredictedReplacements ,
                                               indiv:REALTOXICITYPROMPTS ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:ReplaceStereotypes ;
             rdfs:comment "Establishes data and data governance requirements for high-risk AI systems, including quality, relevance, representativeness and appropriate statistical properties of training, validation and testing data. Notes: Umbrella provision for data quality and bias control; detailed constraints are set in specific paragraphs." .


###  https://purl.org/fairops/indiv#Art.10.3
indiv:Art.10.3 rdf:type owl:NamedIndividual ,
                        core:TechnicalLegalRequirement ;
               ns1:SIO_000068 core:EU_AI_Act ;
               core:givesRiseTo core:BiasPerpetuation ,
                                core:DisparateSystemPerformance ,
                                core:Erasure ,
                                core:IncompleteHistoricalExamples ;
               core:isOperationalizedBy indiv:ConditionalStatisticalParity ,
                                        indiv:CounterfactualFairness ,
                                        indiv:DemographicParity ,
                                        indiv:FairnessThroughAwareness ,
                                        indiv:IndividualFairness ,
                                        indiv:StatisticalParity ;
               core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples ,
                                                 indiv:AugmentedAntidoteData ,
                                                 indiv:BlocklistDocumentRemoval ,
                                                 indiv:CDA ,
                                                 indiv:GenderneutralAlternatives ,
                                                 indiv:LogLikeDocumentRemoval ,
                                                 indiv:ReSamplingProtectedGroup ,
                                                 indiv:ReplaceStereotypes ;
               rdfs:comment "Training, validation and testing data must be relevant, representative, free of errors and complete, with appropriate statistical properties, including where applicable in relation to the persons or groups for whom the system is intended. Notes: Central data-governance requirement on distribution and representativeness for fairness." .


###  https://purl.org/fairops/indiv#Art.10.4
indiv:Art.10.4 rdf:type owl:NamedIndividual ,
                        core:TechnicalLegalRequirement ;
               ns1:SIO_000068 core:EU_AI_Act ;
               core:givesRiseTo core:DisparateSystemPerformance ,
                                core:FeedbackLoopOverfitting ,
                                core:IncompleteHistoricalExamples ;
               core:isOperationalizedBy indiv:Calibration ,
                                        indiv:ConditionalStatisticalParity ,
                                        indiv:CounterfactualFairness ,
                                        indiv:DemographicParity ,
                                        indiv:StatisticalParity ,
                                        indiv:TestFairness ;
               core:itsComplianceIsSupportedWith indiv:AugmentedAntidoteData ,
                                                 indiv:CDA ,
                                                 indiv:CalibratedReRanking ,
                                                 indiv:ListReAdjustment ,
                                                 indiv:ReSamplingProtectedGroup ,
                                                 indiv:UserItemReRanking ;
               rdfs:comment "Datasets shall, to the best extent possible, take into account the specific geographical, behavioural and functional context in which the AI system is intended to be used, so that performance and fairness generalise to the deployment environment. Notes: Addresses fairness risks due to domain shift between training data and the real-world context of use." .


###  https://purl.org/fairops/indiv#Art.10.5
indiv:Art.10.5 rdf:type owl:NamedIndividual ,
                        core:ManagementLegalRequirement ,
                        core:TechnicalLegalRequirement ;
               ns1:SIO_000068 core:EU_AI_Act ;
               core:isOperationalizedBy indiv:Calibration ,
                                        indiv:ConditionalStatisticalParity ,
                                        indiv:CounterfactualFairness ,
                                        indiv:DemographicParity ,
                                        indiv:EqualOpportunity ,
                                        indiv:EqualizedOdds ,
                                        indiv:ErrorRateBalance ,
                                        indiv:FalseNegativeErrorRateBalance ,
                                        indiv:FalsePositiveErrorRateBalance ,
                                        indiv:PredictiveEquality ,
                                        indiv:StatisticalParity ,
                                        indiv:TestFairness ;
               core:itsComplianceIsSupportedWith indiv:AdversarialFDP ,
                                                 indiv:AugmentedAntidoteData ,
                                                 indiv:CDA ,
                                                 indiv:PerceptronForUnawareness ,
                                                 indiv:ReSamplingProtectedGroup ,
                                                 indiv:RegularizationOnANOVA ,
                                                 indiv:RegularizationOnValueFairness ;
               rdfs:comment "Allows, under strict conditions, the processing of special categories of personal data for the purposes of detecting, preventing or mitigating bias in AI systems, subject to Union data-protection law. Notes: Enables fairness-aware use of sensitive attributes while maintaining data-protection safeguards." .


###  https://purl.org/fairops/indiv#Art.11
indiv:Art.11 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:givesRiseTo core:BiasPerpetuation ,
                              core:DerogatoryLanguage ,
                              core:DisparateSystemPerformance ,
                              core:Erasure ,
                              core:ExclusionaryNorms ,
                              core:Misrepresentation ,
                              core:Stereotyping ,
                              core:Toxicity ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:ConditionalStatisticalParity ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:ErrorRateBalance ,
                                      indiv:FairnessThroughAwareness ,
                                      indiv:FalseNegativeErrorRateBalance ,
                                      indiv:FalsePositiveErrorRateBalance ,
                                      indiv:IndividualFairness ,
                                      indiv:PredictiveEquality ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples ,
                                               indiv:AdversarialFDP ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:BlocklistDocumentRemoval ,
                                               indiv:CDA ,
                                               indiv:CalibratedReRanking ,
                                               indiv:ControlOffensiveTokens ,
                                               indiv:ListReAdjustment ,
                                               indiv:LogLikeDocumentRemoval ,
                                               indiv:PerceptronForUnawareness ,
                                               indiv:REALTOXICITYPROMPTS ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:RegularizationOnANOVA ,
                                               indiv:RegularizationOnValueFairness ,
                                               indiv:UserItemReRanking ;
             rdfs:comment "Obliges providers to draw up technical documentation demonstrating compliance with the requirements, including design choices, data sources, model properties, performance and limitations relevant to fairness and non-discrimination. Notes: Traceability layer: binds legal compliance claims to explicit notions, indicators, and documented controls; requires before/after evidence and clear limitations for authority review and conformity assessment." .


###  https://purl.org/fairops/indiv#Art.112.10
indiv:Art.112.10 rdf:type owl:NamedIndividual ,
                          core:ManagementLegalRequirement ;
                 ns1:SIO_000068 core:EU_AI_Act ;
                 core:isOperationalizedBy indiv:Calibration ,
                                          indiv:DemographicParity ,
                                          indiv:EqualOpportunity ,
                                          indiv:EqualizedOdds ,
                                          indiv:StatisticalParity ;
                 rdfs:comment "Requires the Commission to evaluate and review the implementation of the Regulation and, where appropriate, propose amendments, taking into account technological developments and the effects of AI systems on health, safety and fundamental rights, including equality and non-discrimination. Notes: This is a governance/evaluation obligation: notions/metrics are mapped as evaluation indicators aggregated across systems (not as system-level compliance targets)." .


###  https://purl.org/fairops/indiv#Art.12
indiv:Art.12 rdf:type owl:NamedIndividual ,
                      core:TechnicalLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:givesRiseTo core:DerogatoryLanguage ,
                              core:DisparateSystemPerformance ,
                              core:ExclusionaryNorms ,
                              core:FeedbackLoopOverfitting ,
                              core:Misrepresentation ,
                              core:PopularItemsOverrecommended ,
                              core:Stereotyping ,
                              core:Toxicity ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:ConditionalStatisticalParity ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:ErrorRateBalance ,
                                      indiv:FairnessThroughAwareness ,
                                      indiv:FalseNegativeErrorRateBalance ,
                                      indiv:FalsePositiveErrorRateBalance ,
                                      indiv:IndividualFairness ,
                                      indiv:PredictiveEquality ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples ,
                                               indiv:AdversarialFDP ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:BlocklistDocumentRemoval ,
                                               indiv:CDA ,
                                               indiv:CalibratedReRanking ,
                                               indiv:ControlOffensiveTokens ,
                                               indiv:ListReAdjustment ,
                                               indiv:LogLikeDocumentRemoval ,
                                               indiv:PerceptronForUnawareness ,
                                               indiv:REALTOXICITYPROMPTS ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:RegularizationOnANOVA ,
                                               indiv:RegularizationOnValueFairness ,
                                               indiv:UserItemReRanking ;
             rdfs:comment "Requires that high-risk AI systems are designed with automatic logging capabilities to record events relevant for performance monitoring and compliance, including behaviour affecting fundamental rights. Notes: Observability layer: logs enable traceability of system behaviour across versions and contexts and support monitoring and audit activities; however, fairness monitoring requires additional design choices to ensure that logs capture relevant signals for bias detection and drift analysis, which are not fully specified by the Regulation" .


###  https://purl.org/fairops/indiv#Art.13
indiv:Art.13 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:givesRiseTo core:Misrepresentation ,
                              core:MisrepresentationsInProductMarketing ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:ConditionalStatisticalParity ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:ErrorRateBalance ,
                                      indiv:FalseNegativeErrorRateBalance ,
                                      indiv:FalsePositiveErrorRateBalance ,
                                      indiv:PredictiveEquality ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples ,
                                               indiv:AdversarialFDP ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:BlocklistDocumentRemoval ,
                                               indiv:CDA ,
                                               indiv:CalibratedReRanking ,
                                               indiv:ControlOffensiveTokens ,
                                               indiv:ListReAdjustment ,
                                               indiv:LogLikeDocumentRemoval ,
                                               indiv:PerceptronForUnawareness ,
                                               indiv:REALTOXICITYPROMPTS ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:RegularizationOnANOVA ,
                                               indiv:RegularizationOnValueFairness ,
                                               indiv:UserItemReRanking ;
             rdfs:comment "Requires providers to ensure that high-risk AI systems are accompanied by clear instructions for use and information about performance, assumptions, limitations and foreseeable risks to fundamental rights. Notes: Operational transparency layer: communicate applicable fairness notions, the metrics used to evidence them (incl. parity, error gaps, counterfactual instability, calibration/divergence), evaluation conditions and limits; document active safeguards and the operational response when monitoring signals degrade." .


###  https://purl.org/fairops/indiv#Art.14
indiv:Art.14 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:givesRiseTo core:DerogatoryLanguage ,
                              core:Erasure ,
                              core:ExclusionaryNorms ,
                              core:Misrepresentation ,
                              core:MisrepresentationsInProductMarketing ,
                              core:PopularItemsOverrecommended ,
                              core:Stereotyping ,
                              core:Toxicity ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:ConditionalStatisticalParity ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:ErrorRateBalance ,
                                      indiv:FairnessThroughAwareness ,
                                      indiv:FalseNegativeErrorRateBalance ,
                                      indiv:FalsePositiveErrorRateBalance ,
                                      indiv:IndividualFairness ,
                                      indiv:PredictiveEquality ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples ,
                                               indiv:AdversarialFDP ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:BlocklistDocumentRemoval ,
                                               indiv:CDA ,
                                               indiv:CalibratedReRanking ,
                                               indiv:ControlOffensiveTokens ,
                                               indiv:ListReAdjustment ,
                                               indiv:LogLikeDocumentRemoval ,
                                               indiv:PerceptronForUnawareness ,
                                               indiv:REALTOXICITYPROMPTS ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:RegularizationOnANOVA ,
                                               indiv:RegularizationOnValueFairness ,
                                               indiv:UserItemReRanking ;
             rdfs:comment "Requires that high-risk AI systems be designed and developed with effective human oversight, enabling human operators to understand, monitor and intervene to prevent or minimise harm, including discriminatory outcomes. Notes: Art. 14 binds fairness monitoring to human interventions: define operator-facing fairness signals, thresholds and escalation; enable override/adjustment actions and corrective controls; evidence effectiveness through improvements in the same monitored metrics." .


###  https://purl.org/fairops/indiv#Art.15
indiv:Art.15 rdf:type owl:NamedIndividual ,
                      core:TechnicalLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:ConditionalStatisticalParity ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:ErrorRateBalance ,
                                      indiv:FairnessThroughAwareness ,
                                      indiv:FalseNegativeErrorRateBalance ,
                                      indiv:FalsePositiveErrorRateBalance ,
                                      indiv:IndividualFairness ,
                                      indiv:PredictiveEquality ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples ,
                                               indiv:AdvBERT ,
                                               indiv:AdvPredictedScore ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:BlocklistDocumentRemoval ,
                                               indiv:CDA ,
                                               indiv:CalibratedReRanking ,
                                               indiv:ChangeAttentionScores ,
                                               indiv:ChangeAttentionWeights ,
                                               indiv:ControlOffensiveTokens ,
                                               indiv:DropoutOnAttention ,
                                               indiv:InferenceSubnetworks ,
                                               indiv:ListReAdjustment ,
                                               indiv:LogLikeDocumentRemoval ,
                                               indiv:OSCAR ,
                                               indiv:REALTOXICITYPROMPTS ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:RegularizationOnANOVA ,
                                               indiv:RegularizationOnValueFairness ,
                                               indiv:UserItemReRanking ;
             rdfs:comment "Requires high-risk AI systems to achieve appropriate levels of accuracy, robustness and cybersecurity, and to maintain these properties throughout the lifecycle. Notes: Art. 15 is mapped to robustness and cybersecurity monitoring where degradations can create group-conditional harms. Fairness indicators are used as robustness evidence (error gaps, calibration/divergence drift, local consistency); mitigations are technical controls activated to restore dependability and evidenced via improvements in the same metrics." .


###  https://purl.org/fairops/indiv#Art.16
indiv:Art.16 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:ConditionalStatisticalParity ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:ErrorRateBalance ,
                                      indiv:FairnessThroughAwareness ,
                                      indiv:FalseNegativeErrorRateBalance ,
                                      indiv:FalsePositiveErrorRateBalance ,
                                      indiv:IndividualFairness ,
                                      indiv:PredictiveEquality ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples ,
                                               indiv:AdversarialFDP ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:BlocklistDocumentRemoval ,
                                               indiv:CDA ,
                                               indiv:CalibratedReRanking ,
                                               indiv:ControlOffensiveTokens ,
                                               indiv:ListReAdjustment ,
                                               indiv:LogLikeDocumentRemoval ,
                                               indiv:PerceptronForUnawareness ,
                                               indiv:REALTOXICITYPROMPTS ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:RegularizationOnANOVA ,
                                               indiv:RegularizationOnValueFairness ,
                                               indiv:UserItemReRanking ;
             rdfs:comment "Sets out the obligations of providers of high-risk AI systems, including designing and developing systems in accordance with the requirements and implementing risk management, data governance and monitoring procedures. Notes: Art. 16 is an umbrella provider-duty clause. Mapped notions/metrics form a provider-level evidence portfolio; mapped techniques form the provider control catalogue applied across the lifecycle with documented thresholds, escalation and change management." .


###  https://purl.org/fairops/indiv#Art.17
indiv:Art.17 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:ConditionalStatisticalParity ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:ErrorRateBalance ,
                                      indiv:FairnessThroughAwareness ,
                                      indiv:FalseNegativeErrorRateBalance ,
                                      indiv:FalsePositiveErrorRateBalance ,
                                      indiv:IndividualFairness ,
                                      indiv:PredictiveEquality ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AdversarialFDP ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:CDA ,
                                               indiv:CalibratedReRanking ,
                                               indiv:FairPSL ,
                                               indiv:ListReAdjustment ,
                                               indiv:PerceptronForUnawareness ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:RegularizationOnANOVA ,
                                               indiv:RegularizationOnValueFairness ,
                                               indiv:UserItemReRanking ;
             rdfs:comment "Requires providers to establish and maintain a quality management system covering design, development, testing, validation, data management and monitoring processes for high-risk AI systems. Notes: Art. 17 operationalises compliance via a QMS: define measurable fairness acceptance criteria (release/regression gates), govern approved mitigation methods, document evidence and limitations, and ensure monitoring plus corrective actions are consistently applied across the lifecycle." .


###  https://purl.org/fairops/indiv#Art.2
indiv:Art.2 rdf:type owl:NamedIndividual ,
                     core:ManagementLegalRequirement ;
            ns1:SIO_000068 core:EU_AI_Act ;
            core:isOperationalizedBy indiv:Calibration ,
                                     indiv:CounterfactualFairness ,
                                     indiv:DemographicParity ,
                                     indiv:EqualOpportunity ,
                                     indiv:EqualizedOdds ,
                                     indiv:StatisticalParity ,
                                     indiv:TestFairness ;
            rdfs:comment "Defines the subject matter and scope of the Regulation, specifying which AI systems and providers fall under the uniform requirements, including those on fundamental-rights protection and non-discrimination. Notes: Art. 2 is a scope rule: notions/metrics are mapped as applicability anchors (taxonomy for the types of discrimination evidence referenced by downstream obligations), not as performance thresholds required by Art. 2 itself." .


###  https://purl.org/fairops/indiv#Art.20
indiv:Art.20 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:FairnessThroughAwareness ,
                                      indiv:IndividualFairness ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AdversarialFDP ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:CDA ,
                                               indiv:CalibratedReRanking ,
                                               indiv:ListReAdjustment ,
                                               indiv:PerceptronForUnawareness ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:RegularizationOnANOVA ,
                                               indiv:RegularizationOnValueFairness ,
                                               indiv:UserItemReRanking ;
             rdfs:comment "Corrective actions and duty of information: when a high-risk AI system is non-compliant or presents a risk, the provider must take corrective actions without undue delay (bring into conformity, withdraw/recall, or disable as appropriate) and promptly inform relevant economic operators and competent actors, providing details of the non-compliance/risk and actions taken. Notes: Art. 20 is a remediation and information-duty clause: fairness notions/metrics serve as operational triggers and regression evidence; mapped techniques are corrective controls applied via change management (update/rollback/withdrawal/disable) with before/after metric verification and notification duties." .


###  https://purl.org/fairops/indiv#Art.21
indiv:Art.21 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             rdfs:comment "Requires providers of high-risk AI systems to cooperate with competent authorities and, upon reasoned request, provide necessary information and documentation to demonstrate compliance; where applicable, provide access to automatically generated logs under their control. Notes: Assurance obligation: notions/metrics define the “compliance evidence package” that must be producible, versioned, and interpretable by authorities, including monitoring outputs and (where relevant) log-based evidence." .


###  https://purl.org/fairops/indiv#Art.23
indiv:Art.23 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AdversarialFDP ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:CDA ,
                                               indiv:CalibratedReRanking ,
                                               indiv:ListReAdjustment ,
                                               indiv:PerceptronForUnawareness ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:RegularizationOnANOVA ,
                                               indiv:RegularizationOnValueFairness ,
                                               indiv:UserItemReRanking ;
             rdfs:comment "Sets obligations for importers of high-risk AI systems to verify conformity (incl. required compliance artefacts and instructions), refrain from market placement when non-compliant, ensure storage/transport do not compromise compliance, and cooperate with competent authorities including corrective actions where needed. Notes: Art. 23 acts as a supply-chain compliance gate: notions/metrics define what must be checkable and transferable; mitigation techniques are mapped as documented controls whose configuration and effectiveness evidence must remain aligned with the marketed version and intended context." .


###  https://purl.org/fairops/indiv#Art.24
indiv:Art.24 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:FairnessThroughAwareness ,
                                      indiv:IndividualFairness ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples ,
                                               indiv:AdversarialFDP ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:BlocklistDocumentRemoval ,
                                               indiv:CDA ,
                                               indiv:CalibratedReRanking ,
                                               indiv:ControlOffensiveTokens ,
                                               indiv:GenderneutralAlternatives ,
                                               indiv:ListReAdjustment ,
                                               indiv:LogLikeDocumentRemoval ,
                                               indiv:NamesIntervention ,
                                               indiv:PerceptronForUnawareness ,
                                               indiv:PoliteAlternatives ,
                                               indiv:PredictedReplacements ,
                                               indiv:REALTOXICITYPROMPTS ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:RegularizationOnANOVA ,
                                               indiv:RegularizationOnValueFairness ,
                                               indiv:ReplaceStereotypes ,
                                               indiv:UserItemReRanking ;
             rdfs:comment "Sets obligations for distributors of high-risk AI systems to ensure compliance at market placement (e.g., presence of required documentation/instructions and integrity of the supplied system), cooperate with competent authorities, and take actions when non-compliance or risks are suspected. Notes: Distributor-side role is assurance: verify the provider’s conformity package (incl. fairness indicators/limits and declared controls) is present and not neutralised by integration/packaging choices; if issues arise, coordinate corrective actions and preserve traceability to the supplied version." .


###  https://purl.org/fairops/indiv#Art.25
indiv:Art.25 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             rdfs:comment "Clarifies responsibilities along the AI value chain for high-risk AI systems, including when another actor becomes the provider (e.g., branding, substantial modification, or purpose change) and related cooperation duties between actors. Notes: Value-chain governance: notions/metrics are mapped as handover anchors for fairness evidence. If accountability shifts, the new provider must inherit and/or regenerate the mapped evidence and monitoring, traceable to the modified version and context of use." .


###  https://purl.org/fairops/indiv#Art.26
indiv:Art.26 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:ConditionalStatisticalParity ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:FairnessThroughAwareness ,
                                      indiv:IndividualFairness ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples ,
                                               indiv:AdversarialFDP ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:BlocklistDocumentRemoval ,
                                               indiv:CDA ,
                                               indiv:CalibratedReRanking ,
                                               indiv:ControlOffensiveTokens ,
                                               indiv:FairPSL ,
                                               indiv:ListReAdjustment ,
                                               indiv:LogLikeDocumentRemoval ,
                                               indiv:PerceptronForUnawareness ,
                                               indiv:REALTOXICITYPROMPTS ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:RegularizationOnANOVA ,
                                               indiv:RegularizationOnValueFairness ,
                                               indiv:UserItemReRanking ;
             rdfs:comment "Specifies additional obligations for deployers of high-risk AI systems, including using systems in accordance with instructions and monitoring operation, especially where decisions significantly affect individuals. Notes: Art. 26 is deployer-side operational compliance: implement monitoring KPIs (parity/error gaps/drift/consistency), define thresholds and escalation, apply workflow interventions and (where applicable) corrective controls directly or via provider coordination; evidence effectiveness through improvements in the monitored metrics." .


###  https://purl.org/fairops/indiv#Art.27
indiv:Art.27 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:ConditionalStatisticalParity ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:FairnessThroughAwareness ,
                                      indiv:IndividualFairness ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples ,
                                               indiv:AdversarialFDP ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:BlocklistDocumentRemoval ,
                                               indiv:CDA ,
                                               indiv:CalibratedReRanking ,
                                               indiv:ControlOffensiveTokens ,
                                               indiv:FairPSL ,
                                               indiv:ListReAdjustment ,
                                               indiv:LogLikeDocumentRemoval ,
                                               indiv:PerceptronForUnawareness ,
                                               indiv:REALTOXICITYPROMPTS ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:RegularizationOnANOVA ,
                                               indiv:RegularizationOnValueFairness ,
                                               indiv:UserItemReRanking ;
             rdfs:comment "Requires deployers of certain high-risk AI systems to perform a fundamental rights impact assessment (FRIA), identifying and evaluating risks to fundamental rights, including discrimination, and defining mitigation measures. Notes: Art. 27 is an ex-ante governance activity: select applicable fairness notions, compute risk indicators, set decision thresholds and escalation, define mitigations and verify effectiveness via the same mapped metrics; update FRIA when context or system version changes." .


###  https://purl.org/fairops/indiv#Art.29
indiv:Art.29 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:ConditionalStatisticalParity ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:FairnessThroughAwareness ,
                                      indiv:IndividualFairness ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples ,
                                               indiv:AdversarialFDP ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:BlocklistDocumentRemoval ,
                                               indiv:CDA ,
                                               indiv:CalibratedReRanking ,
                                               indiv:ControlOffensiveTokens ,
                                               indiv:FairPSL ,
                                               indiv:ListReAdjustment ,
                                               indiv:LogLikeDocumentRemoval ,
                                               indiv:PerceptronForUnawareness ,
                                               indiv:REALTOXICITYPROMPTS ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:RegularizationOnANOVA ,
                                               indiv:RegularizationOnValueFairness ,
                                               indiv:UserItemReRanking ;
             rdfs:comment "Regulates the application and notification procedure for organisations that wish to act as notified bodies for high-risk AI systems, including competence requirements. Notes: Art. 29 is a meta-governance requirement: map fairness notions/metrics as assessment competence needed by notified bodies to validate provider evidence; map mitigation techniques as controls whose appropriateness/configuration/effectiveness must be reviewable and evidenced through the same indicators." .


###  https://purl.org/fairops/indiv#Art.3
indiv:Art.3 rdf:type owl:NamedIndividual ,
                     core:ManagementLegalRequirement ;
            ns1:SIO_000068 core:EU_AI_Act ;
            core:isOperationalizedBy indiv:Calibration ,
                                     indiv:CounterfactualFairness ,
                                     indiv:DemographicParity ,
                                     indiv:EqualOpportunity ,
                                     indiv:EqualizedOdds ,
                                     indiv:StatisticalParity ,
                                     indiv:TestFairness ;
            rdfs:comment "Provides core definitions (AI system, provider, deployer, high-risk AI system, general-purpose AI model) that allocate responsibilities for compliance with fairness and non-discrimination requirements. Notes: Art. 3 is definitional: notions/metrics are mapped as traceability anchors to assign fairness evidence and monitoring duties to the correct actor/artefact; mitigation techniques are mapped as control-accountability anchors (who implements and documents controls)." .


###  https://purl.org/fairops/indiv#Art.4
indiv:Art.4 rdf:type owl:NamedIndividual ,
                     core:ManagementLegalRequirement ;
            ns1:SIO_000068 core:EU_AI_Act ;
            core:isOperationalizedBy indiv:Calibration ,
                                     indiv:CounterfactualFairness ,
                                     indiv:DemographicParity ,
                                     indiv:EqualOpportunity ,
                                     indiv:EqualizedOdds ,
                                     indiv:FairnessThroughAwareness ,
                                     indiv:IndividualFairness ,
                                     indiv:StatisticalParity ,
                                     indiv:TestFairness ;
            rdfs:comment "Requires providers and deployers to take measures to ensure, to the best extent possible, a sufficient level of AI literacy for staff and other persons dealing with the operation and use of AI systems, considering their skills and the context of use. Notes: Principle/enabler: notions/metrics are mapped as training and operational interpretation anchors; the obligation is implemented via competence management (training, procedures), not via a single technical threshold." .


###  https://purl.org/fairops/indiv#Art.43
indiv:Art.43 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:ConditionalStatisticalParity ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:FairnessThroughAwareness ,
                                      indiv:IndividualFairness ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples ,
                                               indiv:AdversarialFDP ,
                                               indiv:AugmentedAntidoteData ,
                                               indiv:BlocklistDocumentRemoval ,
                                               indiv:CDA ,
                                               indiv:CalibratedReRanking ,
                                               indiv:ControlOffensiveTokens ,
                                               indiv:FairPSL ,
                                               indiv:ListReAdjustment ,
                                               indiv:LogLikeDocumentRemoval ,
                                               indiv:PerceptronForUnawareness ,
                                               indiv:REALTOXICITYPROMPTS ,
                                               indiv:ReSamplingProtectedGroup ,
                                               indiv:RegularizationOnANOVA ,
                                               indiv:RegularizationOnValueFairness ,
                                               indiv:UserItemReRanking ;
             rdfs:comment "Lays down rules for conformity assessment procedures for high-risk AI systems, including assessment of compliance with all applicable requirements of the Regulation. Notes: Art. 43 is an assurance gate: map notions/metrics as acceptance criteria and test evidence; map mitigations as controls whose presence/configuration/effectiveness must be demonstrable and traceable to the assessed system version (including regression evidence after changes)." .


###  https://purl.org/fairops/indiv#Art.5
indiv:Art.5 rdf:type owl:NamedIndividual ,
                     core:ManagementLegalRequirement ;
            ns1:SIO_000068 core:EU_AI_Act ;
            core:isOperationalizedBy indiv:Calibration ,
                                     indiv:ConditionalStatisticalParity ,
                                     indiv:CounterfactualFairness ,
                                     indiv:DemographicParity ,
                                     indiv:EqualOpportunity ,
                                     indiv:EqualizedOdds ,
                                     indiv:ErrorRateBalance ,
                                     indiv:FairnessThroughAwareness ,
                                     indiv:FalseNegativeErrorRateBalance ,
                                     indiv:FalsePositiveErrorRateBalance ,
                                     indiv:IndividualFairness ,
                                     indiv:PredictiveEquality ,
                                     indiv:StatisticalParity ,
                                     indiv:TestFairness ,
                                     indiv:TotalFairness ,
                                     indiv:TreatmentEquality ;
            rdfs:comment "Prohibits certain AI practices, such as exploiting vulnerabilities of specific groups, social scoring, and some forms of predictive policing, which are considered incompatible with fundamental rights and equality. Notes: Directly excludes particularly harmful and discriminatory uses of AI systems." .


###  https://purl.org/fairops/indiv#Art.50
indiv:Art.50 rdf:type owl:NamedIndividual ,
                      core:ManagementLegalRequirement ;
             ns1:SIO_000068 core:EU_AI_Act ;
             core:isOperationalizedBy indiv:Calibration ,
                                      indiv:CounterfactualFairness ,
                                      indiv:DemographicParity ,
                                      indiv:EqualOpportunity ,
                                      indiv:EqualizedOdds ,
                                      indiv:StatisticalParity ,
                                      indiv:TestFairness ;
             core:itsComplianceIsSupportedWith indiv:AddNonToxicExamples ,
                                               indiv:BlocklistDocumentRemoval ,
                                               indiv:ControlOffensiveTokens ,
                                               indiv:GenderneutralAlternatives ,
                                               indiv:LogLikeDocumentRemoval ,
                                               indiv:NamesIntervention ,
                                               indiv:PoliteAlternatives ,
                                               indiv:REALTOXICITYPROMPTS ,
                                               indiv:ReplaceStereotypes ;
             rdfs:comment "Introduces specific transparency obligations for certain AI systems, such as those interacting with humans or detecting emotions, requiring users to be informed that they are interacting with AI. Notes: Renumbered to Art. 50 to match Regulation (EU) 2024/1689; transparency obligations mapped as operational control and risk-indicator support for discrimination detection." .


###  https://purl.org/fairops/indiv#Art.53
