###  https://purl.org/fairops/indiv#StatisticalParity
indiv:StatisticalParity rdf:type owl:NamedIndividual ,
                                 core:IndependenceFairnessNotion ,
                                 core:ObservationalFairnessNotion ;
                        core:isMeasuredBy indiv:DisparateImpact ;
                        core:isProposedBy <https://purl.org/fairops/papers#2012_KAMISHIMA> ,
                                          <https://purl.org/fairops/papers#2013_ZEMEL> ;
                        core:isSuitableFor core:Conversation ,
                                           core:Prediction ,
                                           core:Recommendation ;
                        core:isUsedBy <https://purl.org/fairops/papers#2015_FELDMAN> ,
                                      <https://purl.org/fairops/papers#2017_CORBETT_DAVIES> ;
                        core:refersTo core:Classification ,
                                      core:TextGeneration ;
                        core:scientificArtifactDescription """Each group must have the same probability of being classified with the positive outcome. I.e., the fraction of predicted positive of group a should be equal to that of group b.
$Pr(\\hat{Y} = 1|A= a) = Pr(\\hat{Y} = 1| A=b)$""" ;
                        rdfs:comment "or NLP classification tasks, or tasks with a superimposed classifier, traditional fairness definitions like equalized odds or statistical parity MAY be used without modification[2024_Gallegos]" .


