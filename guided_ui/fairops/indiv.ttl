                                                 <https://purl.org/fairops/papers#2021_DEV> ,
                                                 <https://purl.org/fairops/papers#2021_GE> ,
                                                 <https://purl.org/fairops/papers#2021_ISLAM> ,
                                                 <https://purl.org/fairops/papers#2021_JAIN> ,
                                                 <https://purl.org/fairops/papers#2021_LAUSCHER> ,
                                                 <https://purl.org/fairops/papers#2021_NGO> ,
