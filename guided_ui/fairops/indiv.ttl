###  https://purl.org/fairops/indiv#ScoreBias
indiv:ScoreBias rdf:type owl:NamedIndividual ,
                         core:ClassifierFairnessMetric ;
                core:isProposedBy <https://purl.org/fairops/papers#2020_LU> ;
                core:isSuitableFor core:Conversation ;
                core:measures indiv:StatisticalParity ;
                core:refersTo core:TextGeneration ;
                core:scientificArtifactDescription """Given a set of matched pairs $D$ (or a class of sets $\\mathcal{D}$) and a scoring function $s$,
the bias of $s$ under the concept(s) tested by $D$ (or $\\mathcal{D}$),
denoted by $B_s(D)$ (or $B_s(\\mathcal{D})$), is defined as the expected difference
in scores assigned to the matched pairs (or the expected absolute bias across class members):
\\[
B_s(D) \\;\\stackrel{\\mathrm{def}}{=}\\;
\\mathbb{E}_{(a,b)\\in D}\\bigl[s(a) - s(b)\\bigr],
\\qquad
B_s(\\mathcal{D}) \\;\\stackrel{\\mathrm{def}}{=}\\;
\\mathbb{E}_{D \\in \\mathcal{D}}\\!\\left[\\,\\lvert B_s(D) \\rvert\\,\\right].
\\]""" .


