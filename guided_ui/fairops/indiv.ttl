###  https://purl.org/fairops/indiv#EquityOfAmortizedAttention
indiv:EquityOfAmortizedAttention rdf:type owl:NamedIndividual ,
                                          core:ObservationalFairnessNotion ,
                                          core:SufficiencyFairnessNotion ;
                                 core:extends indiv:EquityOfAttention ;
                                 core:isMeasuredBy indiv:KLDivergence ,
                                                   indiv:L1Norm ;
                                 core:isProposedBy <https://purl.org/fairops/papers#2018_BIEGA> ;
                                 core:isSuitableFor core:Recommendation ;
                                 core:refersTo core:ScoringRegression ;
                                 core:scientificArtifactDescription """A sequence of rankings $\\rho_1, \\dots, \\rho_m$ offers equity of amortized attention if each subject receives cumulative attention proportional to her cumulative relevance, i.e.:

\\[
\\frac{\\sum_{l=1}^{m} a^l_{i_1}}{\\sum_{l=1}^{m} r^l_{i_1}} = 
\\frac{\\sum_{l=1}^{m} a^l_{i_2}}{\\sum_{l=1}^{m} r^l_{i_2}}, 
\\quad \\forall u_{i_1}, u_{i_2}.
\\]""" .


###  https://purl.org/fairops/indiv#EquityOfAttention
indiv:EquityOfAttention rdf:type owl:NamedIndividual ,
                                 core:IndividualFairnessNotion ,
                                 core:ObservationalFairnessNotion ;
                        core:extends indiv:EqualityOfAttention ;
                        core:isEquivalentTo indiv:QualityWeightedFairness ;
                        core:isMeasuredBy indiv:KLDivergence ,
                                          indiv:L1Norm ;
                        core:isProposedBy <https://purl.org/fairops/papers#2018_BIEGA> ;
                        core:isSuitableFor core:Recommendation ;
                        core:refersTo core:ScoringRegression ;
                        core:scientificArtifactDescription """A ranking offers equity of attention if each subject receives attention proportional to its relevance:
\\begin{equation}
\\frac{a_{i_1}}{r_{i_1}} = \\frac{a_{i_2}}{r_{i_2}}, \\quad \\forall\\, u_{i_1}, u_{i_2}.
\\end{equation}""" .


