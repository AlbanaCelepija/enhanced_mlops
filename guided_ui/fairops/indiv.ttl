                                                 <https://purl.org/fairops/papers#2021_WEBSTER> ,
                                                 <https://purl.org/fairops/papers#2022_BORCHERS> ,
                                                 <https://purl.org/fairops/papers#2022_GACI> ,
                                                 <https://purl.org/fairops/papers#2022_GARIMELLA> ,
                                                 <https://purl.org/fairops/papers#2022_HANa> ,
                                                 <https://purl.org/fairops/papers#2022_MANSOURY> ,
                                                 <https://purl.org/fairops/papers#2022_TOKPO> ,
                                                 <https://purl.org/fairops/papers#2022_WANG> ,
                                                 <https://purl.org/fairops/papers#2023_DHINGRA> ,
                                                 <https://purl.org/fairops/papers#2023_HAUZENBERGER> ,
                                                 <https://purl.org/fairops/papers#2023_KUMARa> ,
                                                 <https://purl.org/fairops/papers#2023_LIU> ,
                                                 <https://purl.org/fairops/papers#2023_PARK> ,
                                                 <https://purl.org/fairops/papers#2023_ZAYED> ,
                                                 <https://purl.org/fairops/papers#2024_SUKUMARAN> ,
                                                 <https://purl.org/fairops/papers#2025_SIKDER> ,
                                                 <https://purl.org/fairops/papers#2025_ZHOU> ;
                               core:measures indiv:CounterfactualFairness ;
                               core:refersTo core:Classification ;
                               core:scientificArtifactDescription """The application of the normalization technique for mutual information to the prejudice index leads to a normalized prejudice index (NPI for short):
\\[
\\mathrm{NPI} = \\frac{\\mathrm{PI}}{\\sqrt{H(Y)\\,H(S)}}.
\\]""" .


###  https://purl.org/fairops/indiv#OSCAR
indiv:OSCAR rdf:type owl:NamedIndividual ,
                     core:Transformation ;
            core:scientificArtifactDescription "Bias removal while maintaining relevant semantic information: orthogonalize two directions that should be independent, such as gender and occupation, while minimizing the change in the embeddings to preserve important semantic meaning from gendered words." .


###  https://purl.org/fairops/indiv#OpportunityFairness
indiv:OpportunityFairness rdf:type owl:NamedIndividual ,
                                   core:ItemFocusedMetric ,
                                   core:SingleGranularityMetric ,
                                   core:TreatmentFocusedMetric ;
                          core:extends indiv:JainIndex ;
                          core:isEquivalentTo indiv:JainIndex ;
                          core:isProposedBy <https://purl.org/fairops/papers#2020_ZHU> ;
                          core:isSuitableFor core:Recommendation ;
                          core:measures indiv:StatisticalParity ;
                          core:refersTo core:ScoringRegression ;
                          core:scientificArtifactDescription """Opportunity fairness is a metric to measure the fairness of recommendation opportunity, which can be expressed by Jain’s fairness index~\\cite{20}:
\\begin{equation}
J(\\mathbf{a}) = \\frac{\\left( \\sum_{i=1}^{n} a_i \\right)^2}{n \\sum_{i=1}^{n} a_i^2}
\\end{equation}
where $J(\\mathbf{a})$ denotes Jain’s fairness index, $n$ denotes the total number of candidates with the same function, and $a_i$ represents the number of recommendations of APP $i$. The value $a_i$ can be any positive integer.""" .


