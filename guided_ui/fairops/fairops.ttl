core:RecommendationFairnessConcern rdf:type owl:Class ;
                                   rdfs:subClassOf core:FairnessConcern ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty core:arisesIn ;
                                                     owl:hasValue core:Recommendation
                                                   ] .


###  https://purl.org/fairops/core#RecommendationSystemMetric
core:RecommendationSystemMetric rdf:type owl:Class ;
                                rdfs:subClassOf fmo:fairness_metric ;
                                rdfs:label "Recommendation System Metric"@en .


