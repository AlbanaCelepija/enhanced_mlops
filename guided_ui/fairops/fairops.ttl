core:PartialFineTuning rdf:type owl:Class ;
                       rdfs:subClassOf core:ModelAccessResourcesMitigation ,
                                       core:TrainingResourcesMitigation ;
                       rdfs:label "Partial Fine-tuning - White-box Model (G)"@en .


