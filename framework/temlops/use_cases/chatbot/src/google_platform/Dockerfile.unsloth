# Training container for Unsloth. Vertex's prebuilt images don't work here:
# Unsloth needs a matched torch/CUDA/xformers/bitsandbytes set, and resolving
# that at job start is how you get a 40-minute failure instead of a 40-second one.
FROM pytorch/pytorch:2.4.0-cuda12.1-cudnn9-devel

ENV PYTHONUNBUFFERED=1 \
    HF_HOME=/root/.cache/huggingface \
    TOKENIZERS_PARALLELISM=false

RUN apt-get update && apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

# Pin everything. Unsloth moves fast and an unpinned rebuild three weeks from
# now will not reproduce today's run.
RUN pip install --no-cache-dir \
      "unsloth[cu121-torch240]==2024.12.12" \
      "unsloth_zoo==2024.12.7" \
      "trl==0.12.2" \
      "transformers==4.46.3" \
      "peft==0.13.2" \
      "accelerate==1.1.1" \
      "bitsandbytes==0.44.1" \
      "datasets==3.1.0" \
      "xformers==0.0.27.post2" \
      "google-cloud-storage>=2.17"

WORKDIR /app
COPY src/ /app/src/
ENV PYTHONPATH=/app

ENTRYPOINT ["python", "-m", "src.training.unsloth_task"]
